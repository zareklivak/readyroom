# Copy to .env.local and fill in. Committed as a template only — no real values here.

# Shared password for the demo access gate (also used to sign the session cookie).
READYROOM_ACCESS_CODE=

# Anthropic API key for live "Regenerate" brief generation.
# Leave empty to run entirely on precomputed content (no key needed for local dev).
ANTHROPIC_API_KEY=
